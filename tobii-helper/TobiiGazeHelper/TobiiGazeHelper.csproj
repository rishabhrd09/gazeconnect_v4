<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <!-- The legacy vendor SDK uses reflection/PInvoke; do not trim or single-file it. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TobiiGazeHelper</AssemblyName>
    <RootNamespace>TobiiGazeHelper</RootNamespace>
    <Version>3.0.0</Version>
    <Authors>GazeConnect Team</Authors>
    <Description>Tobii Eye Tracker 5 helper for GazeConnect Pro AAC</Description>
  </PropertyGroup>

  <!--
  Local vendor DLLs are build inputs, not evidence of redistribution permission.
  Verify their origin and distribution rights before publishing source or installers.
  See docs/windows-release-audit.md. copy-tobii-dlls.bat validates a supplied source.
  
  Prerequisites:
  1. Install Tobii Experience: https://gaming.tobii.com/getstarted
  2. Calibrate the eye tracker in Tobii Experience
  3. Avoid competing mouse-control software while using app-owned gaze selection.
  -->

  <!-- Managed DLLs: Referenced at compile time, copied to output -->
  <ItemGroup>
    <Reference Include="Tobii.Interaction.Net">
      <HintPath>lib\Tobii.Interaction.Net.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Tobii.Interaction.Model">
      <HintPath>lib\Tobii.Interaction.Model.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <!-- Native/Runtime DLLs: Copied to output directory ROOT (not lib/ subfolder) -->
  <ItemGroup>
    <Content Include="lib\Tobii.EyeX.Client.dll">
      <Link>Tobii.EyeX.Client.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="lib\Tobii.EyeX.Common.dll">
      <Link>Tobii.EyeX.Common.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="lib\tobii_stream_engine.dll">
      <Link>tobii_stream_engine.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="lib\Tobii.Tech.NETCommon.ClrExtensions.dll">
      <Link>Tobii.Tech.NETCommon.ClrExtensions.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
